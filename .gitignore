# Claude Code: agent worktrees and personal settings
/.claude/worktrees/
/.claude/settings.local.json

# Cargo
/target/

# cargo-mutants
mutants.out*/
# insta writes these when a snapshot test fails; accept or reject them, never commit them.
*.pending-snap
*.snap.new

# egui_kittest writes these beside an image snapshot that fails or is updated; review
# them, never commit them.
*.new.png
*.diff.png
*.old.png
