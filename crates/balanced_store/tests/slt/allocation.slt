# Turning a split into a categorised transaction needs its amount and category set too.
statement error CHECK constraint failed: transaction_amount_unless_split
UPDATE "transaction" SET allocation = 'category' WHERE id = 2

statement ok
UPDATE "transaction" SET allocation = 'category', amount = -3, category_id = 0 WHERE id = 2
