# A transaction's shape follows its allocation. A split stores neither an amount nor a
# category; a categorised transaction has both; an opening balance has an amount, no
# payee and no category, and an account has at most one.

statement ok
INSERT INTO account (id, name, kind, position, hidden, closed) VALUES
    (0, 'Checking', 'checking', 0, 0, 0),
    (1, 'Savings', 'savings', 0, 0, 0)

statement ok
INSERT INTO category (id, parent_id, name) VALUES (0, NULL, 'Groceries')

statement ok
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id) VALUES
    (0, 0, '2026-01-01', NULL, '', 'Starting out', 'opening_balance', 100, NULL),
    (1, 0, '2026-01-02', NULL, 'Grocer', '', 'category', -1, 0),
    (2, 0, '2026-01-03', NULL, 'Market', '', 'split', NULL, NULL)

statement error CHECK constraint failed: transaction_amount_unless_split
