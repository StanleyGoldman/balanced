# Every reference must point at a row, and a row still referred to can't be deleted:
# every foreign key is RESTRICT, so the store deletes child rows itself.

statement ok
INSERT INTO account (id, name, kind, position, hidden, closed) VALUES
    (0, 'Checking', 'checking', 0, 0, 0),
    (1, 'Savings', 'savings', 0, 0, 0)

statement ok
