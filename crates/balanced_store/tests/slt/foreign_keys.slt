    (0, 0, '2026-01-01', NULL, 'Grocer', '', 'category', -1, 2),
    (1, 0, '2026-01-02', NULL, 'Market', '', 'split', NULL, NULL),
    (2, 1, '2026-01-01', NULL, '', '', 'opening_balance', 5, NULL)

statement ok
