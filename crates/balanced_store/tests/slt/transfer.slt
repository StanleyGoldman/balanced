# A transfer is a transaction on each side, each pointing at the other. Each side stores
# its amount and has no category. The link must point at a transaction, and no
# transaction is the other side of two. Both sides go in within one SQLite transaction,
# so the link is checked at commit, not row by row.

statement ok
INSERT INTO account (id, name, kind, position, hidden, closed) VALUES
    (0, 'Checking', 'checking', 0, 0, 0),
    (1, 'Savings', 'savings', 0, 0, 0)

statement ok
INSERT INTO category (id, parent_id, name) VALUES (0, NULL, 'Groceries')

statement ok
BEGIN

statement ok
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (0, 0, '2026-01-02', NULL, 'Saving up', '', 'transfer', -200, NULL, 1)

statement ok
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (1, 1, '2026-01-02', NULL, 'Saving up', '', 'transfer', 200, NULL, 0)

statement ok
COMMIT

# The shape of a transfer.

statement error CHECK constraint failed: transaction_amount_unless_split
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', NULL, NULL, 1)

statement error CHECK constraint failed: transaction_category_when_category
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', -1, 0, 1)

statement error CHECK constraint failed: transaction_other_side_when_transfer
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', -1, NULL, NULL)

statement error CHECK constraint failed: transaction_other_side_when_transfer
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, 'Grocer', '', 'category', -1, 0, 1)

statement error CHECK constraint failed: transaction_other_side_when_transfer
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'opening_balance', 100, NULL, 1)

statement error CHECK constraint failed: transaction_other_side_not_itself
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', -1, NULL, 2)

# No transaction is the other side of two.

statement error UNIQUE constraint failed: transaction.other_side_id
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', -1, NULL, 1)

# A link to a transaction that doesn't exist fails at commit.

statement ok
BEGIN

statement ok
INSERT INTO "transaction" (id, account_id, date, number, payee, memo, allocation, amount, category_id, other_side_id) VALUES
    (2, 0, '2026-01-03', NULL, '', '', 'transfer', -1, NULL, 99)

statement error FOREIGN KEY constraint failed
COMMIT

statement ok
ROLLBACK

# Deleting one side alone fails at commit; deleting both in one transaction goes
# through. The link isn't RESTRICT, which SQLite checks as each row goes, before the
# other side could be deleted too.

statement ok
BEGIN

statement ok
DELETE FROM "transaction" WHERE id = 1

statement error FOREIGN KEY constraint failed
COMMIT

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
DELETE FROM "transaction" WHERE id = 0

statement ok
DELETE FROM "transaction" WHERE id = 1

statement ok
COMMIT

query I
SELECT count(*) FROM "transaction"
----
0
